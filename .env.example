# SmartHR MCP Server - Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.

# Your SmartHR subdomain (e.g. "acme" for acme.smarthr.jp)
SMARTHR_SUBDOMAIN=your-company-subdomain

# SmartHR API access token (Bearer token)
SMARTHR_ACCESS_TOKEN=your_smarthr_api_access_token_here
